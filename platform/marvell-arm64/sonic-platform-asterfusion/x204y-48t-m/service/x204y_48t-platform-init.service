[Unit]
Description=Asterfusion x204y-48t-m Platform initialization service
Before=network.target
DefaultDependencies=no

[Service]
Type=simple
ExecStart=/usr/local/bin/asterProcess/main.py install
ExecStop=/usr/local/bin/asterfusion_x204y_48t_util.py uninstall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
