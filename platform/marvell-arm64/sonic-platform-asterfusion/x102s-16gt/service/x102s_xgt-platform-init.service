[Unit]
Description=Asterfusion x102s-xgt Platform initialization service
Before=network.target
DefaultDependencies=no

[Service]
Type=simple
ExecStart=/usr/local/bin/asterProcess/main.py install
ExecStop=/usr/local/bin/asterfusion_x102s_xgt_util.py uninstall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
