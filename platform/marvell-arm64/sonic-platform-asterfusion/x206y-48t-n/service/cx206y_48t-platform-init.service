[Unit]
Description=Asterfusion cx206y-48t Platform initialization service
Before=network.target
DefaultDependencies=no

[Service]
Type=simple
ExecStart=/usr/local/bin/asterProcess/main.py install
ExecStop=/usr/local/bin/asterfusion_cx206y_48t_util.py uninstall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
