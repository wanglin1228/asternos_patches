+                if sfpi_obj is not None:
+                    cal_type = sfpi_obj.get_calibration_type()
+                sfpd_obj._calibration_type = cal_type
+            except:
+                print("Error: call sff8472InterfaceId get_calibration_type() function error")
                 return None
 
