             sfpd_obj = sff8472Dom()
             if sfpd_obj is None:
                 return None
+
+            # read MonitorData
+            try:
+                eeprom_ifraw = self._read_eeprom_specific_bytes(sysfsfile_eeprom, 0, offset)
+                sfpi_obj = sff8472InterfaceId(eeprom_ifraw)
+                cal_type = 0
+                if sfpi_obj is not None:
+                    cal_type = sfpi_obj.get_calibration_type()
+                sfpd_obj._calibration_type = cal_type
+            except:
+                print("Error: call sff8472InterfaceId get_calibration_type() function error")
+                return None
+
             dom_temperature_raw = self._read_eeprom_specific_bytes(sysfsfile_eeprom, (offset + SFP_TEMPE_OFFSET), SFP_TEMPE_WIDTH)
             if dom_temperature_raw is not None:
                 dom_temperature_data = sfpd_obj.parse_temperature(dom_temperature_raw, 0)
@@ -1331,19 +1341,22 @@ class SfpUtilBase(object):
             if sfpd_obj is None:
                 return None
 
